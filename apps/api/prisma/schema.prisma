// Ticketify database schema. Design: PLAN.md section 3.
//
// Conventions
// - Tables/columns are snake_case (@@map/@map) so raw SQL reads naturally.
// - Every instant is timestamptz (UTC). Calendar dates (release date, holiday) are `date`.
// - Money is Int (VND).
// - Ids are UUIDv7 generated by Prisma; raw INSERTs must supply the id.
//
// Constraints Prisma cannot express (exclusion constraint, CHECKs, partial unique indexes)
// live in hand-written SQL migrations — read prisma/README.md before changing them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────
// Must stay identical to packages/shared enums (checked by a unit test).

enum Role {
  USER
  ADMIN
  STAFF

  @@map("role")
}

enum MovieStatus {
  COMING_SOON
  NOW_SHOWING
  ENDED

  @@map("movie_status")
}

/// Vietnamese film classification (Thông tư 05/2023/TT-BVHTTDL).
enum AgeRating {
  P
  K
  T13
  T16
  T18
  C

  @@map("age_rating")
}

enum SeatType {
  STANDARD
  VIP
  COUPLE

  @@map("seat_type")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY

  @@map("day_type")
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED

  @@map("showtime_status")
}

/// AVAILABLE ──hold──► HELD ──confirm──► SOLD; HELD ──release──► AVAILABLE
enum ShowtimeSeatStatus {
  AVAILABLE
  HELD
  SOLD

  @@map("showtime_seat_status")
}

/// PENDING ──► CONFIRMED | NEEDS_REVIEW | EXPIRED
enum BookingStatus {
  PENDING
  CONFIRMED
  NEEDS_REVIEW
  EXPIRED

  @@map("booking_status")
}

/// One row per payment attempt. PENDING ──► SUCCESS | FAILED | EXPIRED
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED

  @@map("payment_status")
}

/// ISSUED ──► CHECKED_IN; ISSUED ──► VOID (manual handling)
enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID

  @@map("ticket_status")
}

/// PENDING ──claim──► PROCESSING ──► PUBLISHED; failures go back to PENDING with
/// nextRetryAt, or to FAILED once retries are exhausted.
enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

// ───────────────────────────── Users & auth ─────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased by the application.
  email        String   @unique
  /// argon2id hash.
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  bookings         Booking[]
  notifications    Notification[]
  checkedInTickets Ticket[]       @relation("TicketCheckedInBy")

  @@map("users")
}

/// Refresh token rotation: each use issues a new token and links the old one via replacedBy.
/// Presenting a token that already has replacedBy/revokedAt signals reuse.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Movie {
  id          String      @id @default(uuid(7)) @db.Uuid
  title       String
  slug        String      @unique
  /// Running time in minutes.
  duration    Int
  /// Object-storage key of the poster image.
  posterKey   String?     @map("poster_key")
  ageRating   AgeRating   @map("age_rating")
  releaseDate DateTime    @map("release_date") @db.Date
  status      MovieStatus @default(COMING_SOON)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  genres    MovieGenre[]
  showtimes Showtime[]

  @@map("movies")
}

model Genre {
  id     String       @id @default(uuid(7)) @db.Uuid
  name   String       @unique
  slug   String       @unique
  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String @map("movie_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([genreId])
  @@map("movie_genres")
}

model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  rows      Int
  cols      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  seats     Seat[]
  showtimes Showtime[]

  @@map("rooms")
}

model Seat {
  id          String   @id @default(uuid(7)) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  /// Row label shown to users, e.g. "A".
  row         String
  /// Seat number within the row, starting at 1.
  number      Int
  type        SeatType @default(STANDARD)
  /// Couple seats sharing the same group must be booked together.
  coupleGroup Int?     @map("couple_group")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  showtimeSeats ShowtimeSeat[]

  @@unique([roomId, row, number])
  @@map("seats")
}

/// No two non-cancelled showtimes may overlap in the same room:
/// exclusion constraint `showtimes_no_overlap` (raw SQL migration).
model Showtime {
  id        String         @id @default(uuid(7)) @db.Uuid
  movieId   String         @map("movie_id") @db.Uuid
  roomId    String         @map("room_id") @db.Uuid
  startsAt  DateTime       @map("starts_at") @db.Timestamptz(3)
  /// startsAt + movie duration + cleaning time. CHECK endsAt > startsAt (raw SQL).
  endsAt    DateTime       @map("ends_at") @db.Timestamptz(3)
  status    ShowtimeStatus @default(SCHEDULED)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  movie         Movie          @relation(fields: [movieId], references: [id])
  room          Room           @relation(fields: [roomId], references: [id])
  showtimeSeats ShowtimeSeat[]
  bookings      Booking[]

  @@index([movieId, startsAt])
  @@index([startsAt])
  @@map("showtimes")
}

// ───────────────────────────── Pricing ─────────────────────────────

model SeatPrice {
  id        String   @id @default(uuid(7)) @db.Uuid
  seatType  SeatType @map("seat_type")
  dayType   DayType  @map("day_type")
  price     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([seatType, dayType])
  @@map("seat_prices")
}

/// Calendar date in the cinema time zone (CINEMA_TZ).
model Holiday {
  id   String   @id @default(uuid(7)) @db.Uuid
  date DateTime @unique @db.Date

  @@map("holidays")
}

model Combo {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  price       Int
  imageKey    String?  @map("image_key")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookingCombos BookingCombo[]

  @@map("combos")
}

// ───────────────────────────── Seat holding ─────────────────────────────

/// Seat state for one showtime — the single source of truth for who holds a seat.
/// CHECKs (raw SQL): HELD ⇒ booking_id and held_until NOT NULL; AVAILABLE ⇒ booking_id NULL;
/// SOLD ⇒ booking_id NOT NULL.
model ShowtimeSeat {
  showtimeId String             @map("showtime_id") @db.Uuid
  seatId     String             @map("seat_id") @db.Uuid
  status     ShowtimeSeatStatus @default(AVAILABLE)
  bookingId  String?            @map("booking_id") @db.Uuid
  heldUntil  DateTime?          @map("held_until") @db.Timestamptz(3)
  /// Price locked when the showtime is created.
  price      Int

  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat         Seat          @relation(fields: [seatId], references: [id])
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]
  tickets      Ticket[]

  @@id([showtimeId, seatId])
  @@index([bookingId])
  @@map("showtime_seats")
}

model Booking {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// Short human-friendly code shown to users.
  code           String        @unique
  userId         String        @map("user_id") @db.Uuid
  showtimeId     String        @map("showtime_id") @db.Uuid
  status         BookingStatus @default(PENDING)
  subtotal       Int
  discount       Int           @default(0)
  total          Int
  /// createdAt + HOLD_TTL: countdown shown to the user; last moment to start a payment.
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  /// expiresAt + PAYMENT_GRACE: seats stay HELD until then to absorb late IPNs.
  holdUntil      DateTime      @map("hold_until") @db.Timestamptz(3)
  idempotencyKey String        @map("idempotency_key")
  /// Hash of the normalized request payload (same key + different hash → 422).
  requestHash    String        @map("request_hash")
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Set by the worker once the confirmation email was sent (at-least-once delivery).
  emailSentAt    DateTime?     @map("email_sent_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id])
  showtime      Showtime       @relation(fields: [showtimeId], references: [id])
  seats         BookingSeat[]
  combos        BookingCombo[]
  payments      Payment[]
  tickets       Ticket[]
  showtimeSeats ShowtimeSeat[]

  @@unique([userId, idempotencyKey])
  @@index([status, holdUntil])
  @@index([showtimeId])
  @@map("bookings")
}

/// Seat history of a booking — kept even after the seat is released.
model BookingSeat {
  id         String @id @default(uuid(7)) @db.Uuid
  bookingId  String @map("booking_id") @db.Uuid
  showtimeId String @map("showtime_id") @db.Uuid
  seatId     String @map("seat_id") @db.Uuid
  price      Int

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showtimeSeat ShowtimeSeat @relation(fields: [showtimeId, seatId], references: [showtimeId, seatId])

  @@unique([bookingId, seatId])
  @@index([showtimeId, seatId])
  @@map("booking_seats")
}

/// Snapshot of combo name and price at booking time.
model BookingCombo {
  id        String @id @default(uuid(7)) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  comboId   String @map("combo_id") @db.Uuid
  comboName String @map("combo_name")
  unitPrice Int    @map("unit_price")
  quantity  Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  combo   Combo   @relation(fields: [comboId], references: [id])

  @@index([bookingId])
  @@map("booking_combos")
}

// ───────────────────────────── Tickets & payments ─────────────────────────────

/// One ticket per seat, created in the payment transaction that confirms the booking.
/// Partial unique (showtime_id, seat_id) WHERE status <> 'VOID' (raw SQL) is the last line
/// of defence against double-selling.
model Ticket {
  id            String       @id @default(uuid(7)) @db.Uuid
  bookingId     String       @map("booking_id") @db.Uuid
  showtimeId    String       @map("showtime_id") @db.Uuid
  seatId        String       @map("seat_id") @db.Uuid
  code          String       @unique
  status        TicketStatus @default(ISSUED)
  checkedInAt   DateTime?    @map("checked_in_at") @db.Timestamptz(3)
  checkedInById String?      @map("checked_in_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking      @relation(fields: [bookingId], references: [id])
  showtimeSeat ShowtimeSeat @relation(fields: [showtimeId, seatId], references: [showtimeId, seatId])
  checkedInBy  User?        @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])

  @@index([bookingId])
  @@index([showtimeId, seatId])
  @@map("tickets")
}

/// One row per payment attempt (VNPay).
/// Partial unique (booking_id) WHERE status = 'SUCCESS' (raw SQL): a booking is paid at most once.
model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  bookingId        String        @map("booking_id") @db.Uuid
  /// vnp_TxnRef sent to VNPay.
  txnRef           String        @unique @map("txn_ref")
  amount           Int
  status           PaymentStatus @default(PENDING)
  /// vnp_TransactionNo. Plain UNIQUE: Postgres treats NULLs as distinct, so many
  /// attempts without a transaction number are allowed.
  vnpTransactionNo String?       @unique @map("vnp_transaction_no")
  bankCode         String?       @map("bank_code")
  responseCode     String?       @map("response_code")
  rawPayload       Json?         @map("raw_payload")
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}

// ───────────────────────────── Messaging ─────────────────────────────

/// Transactional outbox, relayed to BullMQ by the worker.
model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        String
  aggregateId String       @map("aggregate_id")
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  nextRetryAt DateTime     @default(now()) @map("next_retry_at") @db.Timestamptz(3)
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?      @map("locked_by")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Relay poll: WHERE status = 'PENDING' AND next_retry_at <= now() ... SKIP LOCKED
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
