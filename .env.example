# Copy to .env at the repo root:  cp .env.example .env
# Every key below is validated at startup (apps/api/src/config/env.schema.ts);
# a unit test fails if this file and the schema drift apart.

# ---- Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Which proxies may set X-Forwarded-For (drives req.ip and the per-IP login limit).
# false = socket address (local dev, API exposed directly). Behind one Caddy: 1.
# Also accepts loopback/linklocal/uniquelocal, IPs or CIDRs, comma-separated. "true" is rejected.
TRUST_PROXY=false

# ---- PostgreSQL / Redis (docker-compose.yml)
DATABASE_URL=postgresql://ticketify:ticketify@localhost:5432/ticketify
REDIS_URL=redis://localhost:6379

# ---- Business rules
CINEMA_TZ=Asia/Ho_Chi_Minh
HOLD_TTL_SECONDS=600
PAYMENT_GRACE_SECONDS=300

# ---- Auth — generate a real secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Login attempts per email per window (the per-IP limit is 4x this)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ---- Object storage (RustFS locally, any S3-compatible service in prod)
S3_ENDPOINT=http://localhost:9000
# Origin browsers use for presigned poster URLs, if different from S3_ENDPOINT
# (e.g. API inside Docker uses http://s3:9000, browsers use https://files.example.com). Blank = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=ticketify
S3_SECRET_KEY=ticketify-secret
S3_BUCKET=ticketify
S3_FORCE_PATH_STYLE=true

# ---- SMTP (Mailpit locally: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Ticketify <no-reply@ticketify.local>"

# ---- VNPay sandbox — register at https://sandbox.vnpayment.vn (see README)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# ---- Development seed (pnpm db:seed) — dev-only passwords, never reuse elsewhere
SEED_ADMIN_PASSWORD=dev-admin-password
SEED_STAFF_PASSWORD=dev-staff-password
SEED_USER_PASSWORD=dev-user-password

# ---- Web (Vite exposes only VITE_* keys to the browser)
VITE_API_URL=http://localhost:3000
